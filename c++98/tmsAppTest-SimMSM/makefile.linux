# If undefined in the environment default NDDSHOME to install dir
ifndef NDDSHOME
NDDSHOME := "/home/pauls/rti_connext_dds-7.0.0"
endif

SOURCE_DIR = ./cpp/
COMMON_SOURCE_DIR = ../tmsApp/cpp/

TARGET_ARCH = x64Linux4gcc7.3.0

#TOOLSROOT = # Set the location of the toolchain
#COMPILERSYSROOT = $(TOOLSROOT)/build/tmp/sysroots/genericx86-64
#COMPILER_PATH = $(TOOLSROOT)/build/tmp/sysroots/x86_64-linux/usr/bin/x86_64-wrs-linux

ifndef COMPILER
COMPILER = $(COMPILER_PATH)$(GCC_PREFIX)g++
endif
COMPILER_FLAGS = -m64 -Wall $(ADDITIONAL_COMPILER_FLAGS)
ifndef LINKER
LINKER = $(COMPILER_PATH)$(GCC_PREFIX)g++
endif
LINKER_FLAGS = -m64 $(ADDITIONAL_LINKER_FLAGS)
SYSLIBS = -ldl -lm -lpthread -lrt -no-pie -rdynamic
DEFINES = -DRTI_UNIX -DRTI_LINUX -DRTI_64BIT 
ifndef DEBUG
DEBUG=0
endif
ifeq ($(DEBUG),1)
COMPILER_FLAGS += -g -O0
LINKER_FLAGS += -g
DEBUG_SFX = d
else
DEBUG_SFX = 
endif

ifndef SHAREDLIB
SHAREDLIB=0
endif

ifeq ($(SHAREDLIB),1)
    SHAREDLIB_SFX =
    STATIC_LIBRARIES =
    DYNAMIC_LIBRARIES = 
else
    SHAREDLIB_SFX = z
    DEFINES += -DRTI_STATIC
    STATIC_LIBRARIES = 
    DYNAMIC_LIBRARIES =
endif


INCLUDES = -I. -I./cpp -I../tmsApp/cpp -I$(NDDSHOME)/include -I$(NDDSHOME)/include/ndds 
       
LIBS = -L$(NDDSHOME)/lib/$(TARGET_ARCH) \
        \
        \
        -lnddscpp$(SHAREDLIB_SFX)$(DEBUG_SFX) -lnddsc$(SHAREDLIB_SFX)$(DEBUG_SFX) -lnddscore$(SHAREDLIB_SFX)$(DEBUG_SFX) \
        $(SYSLIBS)

SOURCES = $(COMMON_SOURCE_DIR)tmsCommPatterns.cxx $(SOURCE_DIR)tmsCommPatternTopicHndlrs.cxx
COMMONSOURCES = $(notdir $(SOURCES))

EXEC          = tmsAppTest-SimMSM
DIRECTORIES   = objs.dir objs/$(TARGET_ARCH).dir
COMMONOBJS    = $(COMMONSOURCES:%.cxx=objs/$(TARGET_ARCH)/%.o)

all: $(TARGET_ARCH)

# We actually stick the objects in a sub directory to keep your directory clean.
$(TARGET_ARCH) : $(DIRECTORIES) $(COMMONOBJS) \
	$(EXEC:%=objs/$(TARGET_ARCH)/%.o) \
	$(EXEC:%=objs/$(TARGET_ARCH)/%)

objs/$(TARGET_ARCH)/% : objs/$(TARGET_ARCH)/%.o
	$(LINKER) $(LINKER_FLAGS)   -o $@ $@.o $(COMMONOBJS) $(LIBS)

objs/$(TARGET_ARCH)/%.o : $(SOURCE_DIR)%.cxx 
	$(COMPILER) $(COMPILER_FLAGS)  -o $@ $(DEFINES) $(INCLUDES) -c $<

objs/$(TARGET_ARCH)/%.o : $(COMMON_SOURCE_DIR)%.cxx 
	$(COMPILER) $(COMPILER_FLAGS)  -o $@ $(DEFINES) $(INCLUDES) -c $<
#
# Uncomment these lines if you want the support files regenerated when idl
# file is modified
#
#
#  $(SOURCE_DIR)tmsTestExamplePlugin.cxx $(SOURCE_DIR)tmsTestExample.cxx $(SOURCE_DIR)tmsTestExampleSupport.cxx \
#  $(SOURCE_DIR)tmsTestExample.h $(SOURCE_DIR)tmsTestExamplePlugin.h $(SOURCE_DIR)tmsTestExampleSupport.h : \
#		$(SOURCE_DIR)tmsTestExample.idl
#	$(NDDSHOME)/bin/rtiddsgen $(SOURCE_DIR)tmsTestExample.idl -replace -language C++
#
# Here is how we create those subdirectories automatically.
%.dir : 
	@echo "Checking directory $*"
	@if [ ! -d $* ]; then \
		echo "Making directory $*"; \
		mkdir -p $* ; \
	fi;

clean:
	rm -r objs/
