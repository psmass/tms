# Statically set TMS_TOP_LEVEL_REPO for VSC (comment/uncomment to set with ENV var)
export TMS_TOP_LEVEL_REPO=~/Github/tms
if [[ -z "${TMS_TOP_LEVEL_REPO}" ]];
then
     echo "Error:  Env variable TMS_TOP_LEVEL_REPO: must be set to the top level tms directory (where tms has been cloned) "
     exit
fi
if [ `ps axw | grep 'tmsTestExampleApp' | wc -l` -eq 2 ];
then
    echo "It looks like the process is already runing:"
    echo "      kill `ps axw|grep 'tmsTestExampleApp'| awk '{$1=$1}1'|cut -d ' ' -f 1 | head -n 1`"
    exit
fi
export NDDS_QOS_PROFILES=file://$TMS_TOP_LEVEL_REPO/model/tmsTestApp.xml
echo "Script kicking off tmsTestApp"
./objs/x64Darwin17clang9.0/tmsTestExampleApp